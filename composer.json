{
    "name": "firevel/cloud-tasks-queue-driver",
    "description": "Cloud Tasks queue driver for Laravel apps running inside Google App Engine.",
    "keywords": ["laravel", "firevel", "cloud tasks", "queue"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Slowik",
            "email": "michael.slowik@firevel.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Firevel\\CloudTasksQueueDriver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firevel\\CloudTasksQueueDriver\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firevel\\CloudTasksQueueDriver\\CloudTasksServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "google/cloud-tasks": "^1.8"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
